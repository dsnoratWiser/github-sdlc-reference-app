root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

# Prefer language keywords over framework type names
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Prefer explicit accessibility
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# Prefer using directives outside namespaces
csharp_using_directive_placement = outside_namespace:suggestion

# Prefer braces for clarity and safer maintenance
csharp_prefer_braces = true:suggestion

# Prefer modern namespace syntax where appropriate
csharp_style_namespace_declarations = file_scoped:suggestion

# Prefer expression-bodied members only when they remain clear
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

[*.{csproj,props,targets,slnx,xml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
